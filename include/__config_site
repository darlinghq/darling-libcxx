// DARLING: hand-generated from __config_site.in for libcxx 19.1.7, with the
// settings of Apple's libc++.dylib build (libcxx/cmake/caches/Apple.cmake):
// ABI version 1, vendor availability annotations on, libdispatch PSTL backend.
// The time zone database and the standard library modules are not built.

#ifndef _LIBCPP___CONFIG_SITE
#define _LIBCPP___CONFIG_SITE

/* DARLING: ABI version 1, as in Apple's libc++.dylib. With the macro left
 * undefined the legacy out-of-line copies of now-inline functions
 * (e.g. __shared_weak_count::__add_shared, std::__1::error_category
 * members) are not compiled into the dylib, and binaries built against
 * older libc++ headers fail to bind. */
#define _LIBCPP_ABI_VERSION 1
/* DARLING: matches Apple's libc++.dylib — inline namespace `__1` so that
 * symbol mangling produces `std::__1::*` which is the Apple ABI; otherwise
 * Apple-built binaries cannot bind against our libc++ exports. */
#define _LIBCPP_ABI_NAMESPACE __1
